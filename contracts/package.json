{
  "name": "blind-auction-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Blind Auction smart contracts (Hardhat)",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "node": "cross-env DEV_BLOCK_INTERVAL_MS=5000 hardhat node",
    "clean": "hardhat clean",
    "deploy": "hardhat --network localhost deploy",
    "mint-nft": "hardhat --network localhost mint-nft",
    "create-auction": "hardhat --network localhost create-auction",
    "bid": "hardhat --network localhost bid",
    "reveal": "hardhat --network localhost reveal",
    "finalize": "hardhat --network localhost finalize",
    "withdraw": "hardhat --network localhost withdraw"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "cross-env": "^10.1.0",
    "hardhat": "^2.29.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
