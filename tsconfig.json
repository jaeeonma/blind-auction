{
  // Backend (db/, indexer/, api/, tests/). contracts/ has its own Hardhat tsconfig.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true,
    // web/ is plain browser JavaScript (no build step, design.md 17번); its JSDoc types are checked too.
    "allowJs": true,
    "checkJs": true
  },
  "include": ["db/**/*.ts", "indexer/**/*.ts", "api/**/*.ts", "tests/**/*.ts", "web/**/*.js", "vitest.config.ts"],
  "exclude": ["node_modules", "contracts"]
}
